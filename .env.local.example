NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Emails con acceso a /admin (separados por comas). Sin tabla de roles
# todavía — ver src/lib/adminAuth.ts.
ADMIN_EMAILS=

# Sync de nuevos alumnos y leads de contacto a Brevo — ver
# src/app/api/webhooks/brevo-nuevo-alumno/route.ts.
# BREVO_API_KEY: SMTP & API → API Keys, en el panel de Brevo.
# BREVO_LIST_ID_ALUMNOS / BREVO_LIST_ID_CONTACTO_LEADS: id numérico de cada
# lista (aparece en su URL al entrar en Contacts → Lists → la lista).
# SUPABASE_WEBHOOK_SECRET: cualquier cadena aleatoria propia (openssl rand
# -hex 32); tiene que coincidir con la cabecera x-webhook-secret que
# configures en los Database Webhooks de Supabase (profiles y contactos).
BREVO_API_KEY=
BREVO_LIST_ID_ALUMNOS=
BREVO_LIST_ID_CONTACTO_LEADS=
SUPABASE_WEBHOOK_SECRET=
